{
  "name": "내부평가 성과관리",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "remoteUser": "vscode",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "성과관리 프로그램",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    }
  },
  "postStartCommand": "python .devcontainer/start.py",
  "waitFor": "postStartCommand"
}
